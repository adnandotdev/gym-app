{
  "expo": {
    "name": "LiftSutra",
    "slug": "musclemap",
    "version": "1.0.0",
    "sdkVersion": "57.0.0",
    "description": "Your personal gym companion — visualize muscles, plan workouts, track progress.",
    "orientation": "portrait",
    "icon": "./assets/branding/liftsutra-icon.png",
    "userInterfaceStyle": "automatic",
    "ios": {
      "supportsTablet": true
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/branding/liftsutra-adaptive.png",
        "backgroundColor": "#FFFFFF"
      }
    },
    "web": {
      "favicon": "./assets/branding/liftsutra-favicon.png",
      "name": "LiftSutra",
      "shortName": "LiftSutra"
    },
    "plugins": [
      "expo-font",
      "expo-status-bar"
    ]
  }
}
