{
  "expo": {
    "name": "MuscleMap",
    "slug": "musclemap",
    "version": "1.0.0",
    "sdkVersion": "57.0.0",
    "description": "Your personal gym companion — visualize muscles, plan workouts, track progress.",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "ios": {
      "supportsTablet": true
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#FFFFFF"
      }
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-font",
      "expo-status-bar"
    ]
  }
}
