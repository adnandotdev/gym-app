# =========================================================================
# EXPO FRONTEND ENVIRONMENT VARIABLES
# =========================================================================
#
# Crucial Rule: In Expo, any client-side environment variable MUST be
# prefixed with "EXPO_PUBLIC_" to be compiled and accessible in your code.
#
# =========================================================================

# The API URL pointing to the Express Auth Backend.
# - If testing on an emulator or physical device on the same local network, 
#   replace '192.168.1.100' with your actual computer's local IP address.
# - DO NOT use 'localhost' or '127.0.0.1' as mobile emulators/devices treat
#   localhost as their own system and won't reach the backend server on your computer.
EXPO_PUBLIC_API_URL=http://192.168.0.110:5000/api
